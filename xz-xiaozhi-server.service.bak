[Unit]
Description=xiaozhi-local Client (Python Client)
After=network-online.target xz-xiaozhi-server.service
Wants=network-online.target xz-xiaozhi-server.service

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/Orangepi-Util-/voice_rec/py-xiaozhi
ExecStart=/usr/bin/env bash -lc 'source /opt/anaconda3/etc/profile.d/conda.sh && conda activate py-xiaozhi && python ./main.py --mode service'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target